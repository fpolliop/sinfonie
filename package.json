{
  "name": "sinfonie",
  "version": "0.1.34",
  "description": "Multi-repo agent workspaces: one workspace spans many repositories, with a crew of models.",
  "main": "./out/main/index.js",
  "author": "Francisco Pollio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-vite build && electron-builder --mac --publish never",
    "release": "electron-vite build && electron-builder --mac --publish always",
    "site:deploy": "wrangler pages deploy . --cwd site --project-name sinfonie --branch main",
    "coupon": "node site/coupon.mjs",
    "feedback": "wrangler d1 execute sinfonie-feedback --remote --json --config site/wrangler.toml --command \"SELECT id, created_at, kind, source, count, app_version, email, substr(message,1,200) AS message FROM feedback ORDER BY id DESC LIMIT 50\"",
    "dev:fresh": "SINFONIE_USER_DATA=$HOME/.sinfonie-fresh electron-vite dev",
    "relay:deploy": "wrangler deploy --config relay/wrangler.toml"
  },
  "build": {
    "appId": "dev.sinfonie.app",
    "productName": "Sinfonie",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "notarize": true,
      "protocols": [
        {
          "name": "Sinfonie",
          "schemes": [
            "sinfonie"
          ]
        }
      ]
    },
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "fpolliop",
      "repo": "sinfonie-releases",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44",
    "electron-builder": "^26.15.3",
    "electron-vite": "5",
    "typescript": "5",
    "vite": "7",
    "wrangler": "4"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/deepseek": "^3.0.39",
    "@ai-sdk/google": "^4.0.63",
    "@ai-sdk/mcp": "^2.0.44",
    "@ai-sdk/openai": "^4.0.58",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@anthropic-ai/claude-agent-sdk": "^0.3.259",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@google-cloud/cloud-sql-connector": "^1.12.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.92",
    "bson": "^7.3.2",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "fast-glob": "^3.3.3",
    "google-auth-library": "11",
    "lucide-react": "^1.40.0",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.3",
    "nanoid": "^6.0.1",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "ssh2": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty",
      "electron-winstaller",
      "@anthropic-ai/claude-agent-sdk"
    ],
    "overrides": {
      "cpu-features": "file:stubs/cpu-features"
    }
  },
  "homepage": "https://sinfonie.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/fpolliop/sinfonie"
  }
}
